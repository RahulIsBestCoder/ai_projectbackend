{
  "name": "hiresense-backend-api",
  "version": "1.0.0",
  "description": "HireSense Backend API - TypeScript/Express modular monolith (auth domain + shared infrastructure)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && npm run copyassets",
    "copyassets": "cp -r src/views dist/ && mkdir -p dist/public",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:dummy": "ts-node src/scripts/seed_dummy_data.ts",
    "seed:mongo": "ts-node src/scripts/seed_mongo.ts",
    "seed:defaults": "ts-node src/scripts/seed_defaults.ts",
    "seed:week": "ts-node src/scripts/seed_week.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multiparty": "^4.2.3",
    "nodemailer": "^6.9.14",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
