<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= report.report?.title || record.name || 'AI Project Report' %></title>
  <style>
    :root{--ink:#0f172a;--muted:#64748b;--line:#cbd5e1;--brand:#4f46e5;--bad:#dc2626;--paper:#fff}*{box-sizing:border-box}
    body{margin:0;background:#e2e8f0;color:var(--ink);font:13px/1.45 Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:12mm auto;padding:14mm;background:var(--paper);box-shadow:0 2px 14px #0002}
    header{display:flex;justify-content:space-between;gap:20px;border-bottom:3px solid var(--ink);padding-bottom:14px}h1{margin:0;font-size:25px}h2{margin:0 0 10px;font-size:14px;text-transform:uppercase;letter-spacing:.06em}h3{margin:10px 0 3px;font-size:11px}p{margin:0}.muted{color:var(--muted)}.small{font-size:10px}
    .badge{align-self:flex-start;padding:5px 9px;border:1px solid #a5b4fc;background:#eef2ff;color:#3730a3;font-size:10px;font-weight:700;text-transform:uppercase}.section{margin-top:18px}.chart table{font-size:10px}.chart th{font-size:10px}thead{display:table-header-group}tr{break-inside:avoid}.grid{display:grid;gap:10px}.kpis{grid-template-columns:repeat(4,1fr)}.cols{grid-template-columns:repeat(2,1fr)}
    .card{border:1px solid var(--line);padding:11px;background:#fff;break-inside:avoid}.kpi-label{color:var(--muted);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.kpi-value{margin-top:4px;font-size:20px;font-weight:800}.progress{height:7px;margin-top:8px;background:#e2e8f0;overflow:hidden}.progress>i{display:block;height:100%;background:var(--feature-color,var(--brand))}.feature-card{border-top:4px solid var(--feature-color)}.status-pill{float:right;padding:2px 7px;border-radius:10px;background:#f1f5f9;color:var(--feature-color);font-size:9px;font-weight:700;text-transform:uppercase}
    table{width:100%;border-collapse:collapse;font-size:10px}th,td{padding:6px;border-bottom:1px solid #e2e8f0;text-align:left}th{background:#f8fafc;color:var(--muted);text-transform:uppercase;font-size:8px}.dept-row td{font-weight:600}.dept-sub{color:#475569;padding-left:14px}.blocked-count{color:#b45309;font-weight:bold}
    .chart{min-height:180px;border:1px solid var(--line);padding:12px;break-inside:avoid}.bars{height:125px;display:flex;align-items:flex-end;gap:8px;border-bottom:1px solid var(--line);padding-top:15px}.bar{flex:1;min-width:18px;background:var(--brand);position:relative}.bar span{position:absolute;bottom:-28px;left:50%;transform:translateX(-50%);font-size:8px;white-space:nowrap;max-width:65px;overflow:hidden;text-overflow:ellipsis}.bar b{position:absolute;top:-16px;width:100%;text-align:center;font-size:8px}
    .donut{width:120px;height:120px;margin:8px auto;border-radius:50%;background:conic-gradient(var(--brand) 0 var(--complete),#e2e8f0 var(--complete) 100%);position:relative}.donut:after{content:attr(data-label);position:absolute;inset:25px;border-radius:50%;background:#fff;display:grid;place-items:center;font-weight:800;font-size:17px}.list{margin:0;padding-left:18px}.list li{margin:5px 0}.risk{border-left:3px solid var(--bad);padding:7px 10px;margin-top:7px;background:#fff7ed}.evidence{font:10px/1.5 Consolas,monospace;color:#475569;overflow-wrap:anywhere}.row{margin:4px 0;overflow-wrap:anywhere}.row b{text-transform:capitalize}footer{margin-top:22px;padding-top:8px;border-top:1px solid var(--line);color:var(--muted);font-size:9px}
    <% /* Taiga sprint table styles (.sprint-summary/.task-status/.blocked-count) removed with the section */ %>
    @page{size:A4;margin:0}@media print{body{background:#fff}.page{margin:0;box-shadow:none}}
  </style>
</head>
<body>
<%
const meta=report.report||{},sum=report.executiveSummary||{},health=report.healthAndTrend||{},velocity=report.velocityAndSprint||{},plan=report.planAndActual||{},work=report.workBreakdown||{},forecast=report.deliveryForecast||{},risk=report.risksAndPredictions||{},ai=report.aiNarrative||{};
const text=(v,f='Not available')=>v===null||v===undefined||v===''?f:String(v),num=v=>Number.isFinite(Number(v))?Number(v):0,pct=v=>v===null||v===undefined?'Not enough delivery data':`${Number(v).toFixed(1).replace('.0','')}%`;
const deadlineRaw=risk.predictions?.deadlineProbability,deadlinePct=deadlineRaw==null?null:(deadlineRaw<=1?deadlineRaw*100:deadlineRaw);
const rows=o=>Object.entries(o||{}).filter(([,v])=>!Array.isArray(v)&&(typeof v!=='object'||v===null));
const label=k=>k.replace(/([A-Z])/g,' $1').replace(/_/g,' ');
const featureColors={implemented:'#16a34a',partial:'#f59e0b',not_implemented:'#dc2626',unknown:'#7c3aed'};
%>
<main class="page" id="report">
  <header><div><div class="small muted">AI PROJECT INTELLIGENCE PLATFORM</div><h1><%= text(meta.title,'Latest Project Report') %></h1><p class="muted"><%= text(meta.project?.name,'Project') %> · <%= text(meta.period?.label,'Latest available project data') %></p><p class="small muted">Generated <%= meta.generatedAt?new Date(meta.generatedAt).toLocaleString('en-US',{timeZone:'UTC'})+' UTC':'—' %> · <%= text(meta.repositoryCount,0) %> repositories</p></div><div class="badge"><%= meta.generatedBy==='heuristic'?'Verified-data fallback':'AI generated' %></div></header>
  <section class="section grid kpis"><div class="card"><div class="kpi-label">Complete</div><div class="kpi-value"><%= pct(sum.overallProgress) %></div></div><div class="card"><div class="kpi-label">Remaining</div><div class="kpi-value"><%= pct(sum.remainingProgress) %></div></div><div class="card"><div class="kpi-label">Tasks</div><div class="kpi-value"><%= text(sum.completedTasks,0) %> / <%= text(sum.totalTasks,0) %></div></div><div class="card"><div class="kpi-label">Deadline outlook score</div><div class="kpi-value"><%= pct(deadlinePct) %></div></div></section>
  <section class="section"><h2>Executive summary</h2><div class="card"><%= text(sum.summary,'No summary available.') %></div></section>
  <% /* Taiga sprint summary and per-developer ratings removed – workforce detail is in the Departments section */ %>
  <% if(report.visualData?.length){ %><section class="section"><h2>Visual overview</h2><div class="grid cols"><% report.visualData.forEach(chart=>{ %><div class="chart"><h2><%= chart.title==='Plan vs actual progress'?'Completion by evidence source':chart.title %></h2><%- reportChart(chart) %></div><% }) %></div></section><% } %>
  <section class="section grid cols"><div class="card"><h2>Health and trend</h2><% rows(health).forEach(([k,v])=>{ %><p class="row"><b><%= label(k) %>:</b> <%= text(v) %></p><% }) %></div><div class="card"><h2>Velocity and sprint</h2><% rows(velocity).forEach(([k,v])=>{ %><p class="row"><b><%= label(k) %>:</b> <%= text(v) %></p><% }) %></div></section>
  <section class="section"><h2>Completion evidence</h2><div class="card"><% rows(plan).forEach(([k,v])=>{ %><p class="row"><b><%= label(k) %>:</b> <%= text(v) %></p><% }) %></div></section>
  <section class="section"><h2>Task assessment and evidence</h2><p class="small muted"><%= work.featureProgressBasis||'' %></p><% if(!(work.byFeature||[]).length){ %><div class="card muted">No feature assessment available.</div><% } %><% (work.byFeature||[]).forEach(feature=>{const featureColor=featureColors[feature.status]||featureColors.unknown;%><div class="card feature-card" style="--feature-color:<%= featureColor %>"><b><%= feature.featureName %></b><% if(feature.sprintName){ %> <span class="small muted">· <%= feature.sprintName %></span><% } %><% if(feature.source==='taiga'){ %> <span class="small muted">· Taiga only</span><% } %><span class="status-pill"><%= feature.status==='unknown'?'No evidence (0%)':feature.status %></span><div class="progress"><i style="width:<%= Math.max(0,Math.min(100,num(feature.progress))) %>%"></i></div><p class="small muted"><%= num(feature.progress) %>% · <% if(feature.signals){ %>Plan: <%= num(feature.signals.plan) %>% · Taiga: <%= num(feature.signals.taiga) %>% · Code: <%= num(feature.signals.repository) %>%<% } %></p><div class="evidence"><%= (feature.evidence||[]).join(' · ')||'No evidence paths reported.' %></div></div><% }) %></section>
  <% if(meta.type==='sprint_review' && report.employeeWorking){ %><section class="section"><h2>Sprint team activity</h2><p class="small muted">Git activity within sprint dates; latest synchronized status of tasks assigned to this sprint.</p><table><thead><tr><th>Department</th><th>Member</th><th>Commits</th><th>Assigned tasks</th><th>Completed tasks</th></tr></thead><tbody><% (report.employeeWorking.departments||[]).forEach(d=>(d.employees||[]).forEach(e=>{ %><tr><td><%= d.department %></td><td><%= e.name %></td><td><%= num(e.gitCommits) %></td><td><%= num(e.taigaTasksAssigned) %></td><td><%= num(e.taigaTasksCompleted) %></td></tr><% })); %></tbody></table></section><% } %>
  <% const workforce=meta.type==='sprint_review'?null:report.departmentWorkforce; %>
  <% if(workforce&&(workforce.departments||[]).length){ %>
  <section class="section"><h2>Departments</h2><p class="small muted">Grouped by repository type<% if(workforce.active_window_days){ %> · active = committed in the last <%= num(workforce.active_window_days) %> days<% } %> · <%= num(workforce.total_employees)||workforce.departments.reduce((sum,d)=>sum+(Number(d.member_count)||(d.employees||[]).length),0) %> people<% if(num(workforce.unlinked_repository_count)>0){ %> · <span class="blocked-count"><%= num(workforce.unlinked_repository_count) %> unlinked repositories</span><% } %></p>
    <table><thead><tr><th>Department</th><th>Member</th><th>Contribution</th></tr></thead><tbody>
    <% workforce.departments.forEach(department=>{const isQa=department.id==='testing';const efficiency=department.efficiency;const members=Number(department.member_count)||(department.employees||[]).length;const actives=Number(department.active_count)||(department.employees||[]).filter(e=>e.active).length; %>
      <tr class="dept-row" style="background:<%= department.color || '#4f46e5' %>1a"><td style="border-left:4px solid <%= department.color || '#4f46e5' %>;color:<%= department.color || '#4f46e5' %>"><b><%= text(department.name) %></b></td><td><%= members %> <%= members===1?'member':'members' %> · <%= actives %> active</td><td><% if(isQa){ %><%= num(department.tasks?.created) %> tasks created · <%= num(department.tasks?.closed) %> closed<% if(efficiency&&efficiency.percent!=null){ %> · QA closure rate <%= pct(efficiency.percent) %><% } %><% } else { %><%= num(department.commit_count) %> commits · +<%= num(department.additions) %> / -<%= num(department.deletions) %> lines<% } %></td></tr>
      <% (department.employees||[]).forEach(employee=>{ %><tr><td class="dept-sub" style="border-left:4px solid <%= department.color || '#4f46e5' %>40"><%= text(department.name) %></td><td class="dept-sub"><%= text(employee.name) %><% if(isQa&&employee.reporting_role==='manager'){ %> · Manager<% } else if(isQa&&employee.reporting_role==='qa'){ %> · QA<% } else if(!isQa&&!employee.active){ %> · inactive<% } %></td><td class="dept-sub"><% if(isQa){ %><%= num(employee.tasks_created||employee.issues?.reported) %> created · <%= num(employee.tasks_closed||employee.issues?.closed) %> closed<% } else { %><%= num(employee.commits) %> commits · +<%= num(employee.additions) %> / -<%= num(employee.deletions) %> lines<% } %></td></tr><% }) %>
    <% }) %></tbody></table>
  </section><% } %>
  <section class="section"><h2>Delivery forecast</h2><div class="grid kpis"><div class="card"><div class="kpi-label">Deadline outlook score</div><div class="kpi-value"><%= pct(forecast.deadlineProbability) %></div></div><div class="card"><div class="kpi-label">Predicted completion</div><div class="kpi-value" style="font-size:14px"><%= forecast.predictedCompletionDate?new Date(forecast.predictedCompletionDate).toISOString().slice(0,10):'Insufficient data' %></div></div><div class="card"><div class="kpi-label">Active developers</div><div class="kpi-value"><%= num(forecast.activeDevelopers) %></div></div><div class="card"><div class="kpi-label">Remaining work</div><div class="kpi-value"><%= pct(forecast.remainingWorkPercent) %></div></div></div><div class="card"><p class="row"><b>Target submission:</b> <%= forecast.targetSubmissionDate?new Date(forecast.targetSubmissionDate).toISOString().slice(0,10):'Not defined' %></p><p class="row"><b>Deadline reachable:</b> <%= forecast.deadlineReachable===null||forecast.deadlineReachable===undefined?'Insufficient data':forecast.deadlineReachable?'Yes':'No' %></p><p class="row"><b>Estimated days remaining:</b> <%= text(forecast.estimatedDaysRemaining) %></p><p class="row"><b>Team progress/week:</b> <%= pct(forecast.teamProgressPerWeek) %></p><p class="row"><b>Commits/developer/week:</b> <%= text(forecast.commitsPerDeveloperPerWeek) %></p><p class="row"><b>Taiga completion efficiency:</b> <%= pct(forecast.taigaCompletionEfficiency) %></p><p class="row"><b>Combined codebase:</b> <%= num(forecast.repositoryCoverage?.frontend) %> frontend + <%= num(forecast.repositoryCoverage?.backend) %> backend repositories</p><p class="small muted">Forecast basis: <%= text(forecast.calculationBasis) %>. Outlook scores are heuristic indicators, not calibrated delivery probabilities. Forecasts require review against current scope and capacity.</p></div></section>
  <section class="section grid cols"><div class="card"><h2>Risks and predictions</h2><p class="row"><b>Overall risk:</b> <%= text(risk.overallRisk,'unknown') %></p><p class="row"><b>Deadline risk:</b> <%= text(risk.deadlineRisk,'unknown') %></p><p class="row"><b>Deadline outlook score:</b> <%= pct(deadlinePct) %></p><% (risk.risks||[]).forEach(item=>{ %><div class="risk"><b><%= item.title %></b><p><%= item.recommendation||item.impact||'' %></p></div><% }) %></div></section>
  <section class="section"><h2>AI findings and recommendations</h2><div class="card"><p><%= text(ai.summary,'') %></p><% if(ai.whatWentWell?.length){ %><h3>What went well</h3><ul class="list"><% ai.whatWentWell.forEach(item=>{ %><li><%= item %></li><% }) %></ul><% } %><% if(ai.whatNeedsAttention?.length){ %><h3>What needs attention</h3><ul class="list"><% ai.whatNeedsAttention.forEach(item=>{ %><li><%= item %></li><% }) %></ul><% } %><% if(ai.recommendations?.length){ %><h3>Recommendations</h3><ul class="list"><% ai.recommendations.forEach(item=>{ %><li><b><%= text(item.priority,'medium') %>:</b> <%= item.action %></li><% }) %></ul><% } %></div></section>
  <section class="section"><h2>Evidence sources</h2><div class="card evidence"><%= (meta.sources||[]).join(', ')||'No sources reported.' %></div></section>
  <footer>Generated from saved report_data. Downloading this PDF does not regenerate the report.</footer>
</main>
</body>
</html>
