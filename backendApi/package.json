{
  "name": "ai_project-backend-api",
  "version": "1.0.0",
  "description": "ai_project Backend API - TypeScript/Express modular monolith (auth domain + shared infrastructure)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "node node_modules/typescript/bin/tsc && npm run copyassets",
    "copyassets": "if exist src\\views xcopy /E /I /Y src\\views dist\\views && if not exist dist\\public mkdir dist\\public",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:dummy": "ts-node src/scripts/seed_dummy_data.ts",
    "seed:mongo": "ts-node src/scripts/seed_mongo.ts",
    "seed:defaults": "ts-node src/scripts/seed_defaults.ts",
    "verify:models": "ts-node src/scripts/verify_ai_connections.ts",
    "verify:git-sync": "ts-node src/scripts/verify_git_sync.ts",
    "verify:sync-refresh": "ts-node src/scripts/verify_sync_refresh.ts",
    "verify:predictions": "ts-node src/scripts/verify_get_by_project.ts",
    "verify:deadline-boundaries": "ts-node src/scripts/verify_deadline_boundary_states.ts",
    "verify:plan-schedule": "ts-node --files src/scripts/verify_plan_schedule.ts",
    "verify:taiga-routes": "ts-node --transpile-only src/scripts/verify_taiga_plan_routes.ts",
    "verify:taiga-publish": "ts-node --transpile-only src/scripts/verify_taiga_publish.ts",
    "verify:ai-dashboard": "ts-node --transpile-only src/scripts/verify_ai_dashboard_averages.ts",
    "verify:github-source": "ts-node src/scripts/verify_github_source_sync.ts",
    "verify:report-repairs": "ts-node --files src/scripts/verify_report_repairs.ts",
    "verify:report-pdf": "ts-node src/scripts/verify_report_pdf.ts",
    "grant:project-access": "ts-node src/scripts/grant_project_access.ts",
    "grant:token-project-access": "ts-node src/scripts/grant_token_project_access.ts",
    "seed:week": "ts-node src/scripts/seed_week.ts",
    "insert:user": "ts-node src/scripts/insert_user.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multiparty": "^4.2.3",
    "nodemailer": "^6.9.14",
    "openai": "^7.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
